---
import JsonLd from '../components/JsonLd.astro';
import Seo from '../components/Seo.astro';
import { FEED_TITLE, FEED_PATH } from '../lib/feed';
import {
	BOOKING_URL,
	CONTACT_EMAIL,
	LINKEDIN_URL,
	SITE_REVISED,
} from '../lib/site';
import '../styles/global.css';

interface Props {
	title: string;
	/** Suppress the brand suffix; title is already complete. See Seo.astro. */
	titleIsComplete?: boolean;
	description: string;
	ogType?: 'website' | 'article';
	/** Schemas to emit alongside the site-wide Person. */
	schema?: Record<string, unknown>[];
	/** Keep the page out of search indexes. */
	noindex?: boolean;
	/** Override the site-wide share card. */
	image?: string;
	/** The sheet name in the footer title block. Defaults to the title. */
	sheet?: string;
	/** The revision date in the footer title block. Defaults to SITE_REVISED. */
	revised?: Date;
}

const {
	title,
	titleIsComplete,
	description,
	ogType,
	schema,
	noindex,
	image,
	sheet = title,
	revised = SITE_REVISED,
} = Astro.props;

const revisedLabel = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
}).format(revised);
const revisedIso = revised.toISOString().slice(0, 10);

const path = Astro.url.pathname;

const sections = [
	{ href: '/about', label: 'About' },
	{ href: '/work', label: 'Work' },
	{ href: '/notes', label: 'Notes' },
	{ href: '/contact', label: 'Contact' },
];

/** Pages that keep their own URL but belong to Work in the nav. */
const workPages = ['/review', '/media'];

/** A section is current when the page is that section or lives beneath it. */
const isCurrent = (href: string) =>
	path === href ||
	path.startsWith(`${href}/`) ||
	(href === '/work' &&
		workPages.some((p) => path === p || path.startsWith(`${p}/`)));
---

<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#eeeeea"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#191b1d"
		/>

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- The two cuts of Charis SIL that render above the fold on every page. -->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/charis-sil-latin-400-normal.woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/charis-sil-latin-700-normal.woff2"
			crossorigin
		/>

		{noindex && <meta name="robots" content="noindex" />}

		<link
			rel="alternate"
			type="application/rss+xml"
			title={FEED_TITLE}
			href={FEED_PATH}
		/>

		<Seo
			title={title}
			titleIsComplete={titleIsComplete}
			description={description}
			ogType={ogType}
			noindex={noindex}
			image={image}
		/>
		<JsonLd extra={schema} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<div class="page">
			<header class="masthead">
				<a class="wordmark" href="/">OkArthur</a>
				<div class="masthead-end">
					<nav class="nav" aria-label="Sections">
						{
							sections.map((section) => (
								<a
									href={section.href}
									aria-current={isCurrent(section.href) ? 'page' : undefined}
								>
									{section.label}
								</a>
							))
						}
					</nav>
					<div class="actions">
						<a class="action" href={`mailto:${CONTACT_EMAIL}`}>Email</a>
						<a
							class="action action-primary"
							href={BOOKING_URL}
							target="_blank"
							rel="noopener noreferrer">Book 30 minutes</a
						>
					</div>
				</div>
			</header>

			<main id="main">
				<slot />
			</main>

			<footer class="footer">
				<!-- A drawing sheet's title block. -->
				<dl class="title-block">
					<div class="tb-cell">
						<dt>Project</dt>
						<dd>OkArthur</dd>
					</div>
					<div class="tb-cell">
						<dt>Sheet</dt>
						<dd>{sheet}</dd>
					</div>
					<div class="tb-cell">
						<dt>Revised</dt>
						<dd><time datetime={revisedIso}>{revisedLabel}</time></dd>
					</div>
					<div class="tb-cell">
						<dt>Contact</dt>
						<dd>
							<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
							<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
								>LinkedIn</a
							>
						</dd>
					</div>
				</dl>
				<div class="footer-inner">
					<p>&copy; 2026 OkArthur</p>
					<nav class="footer-nav" aria-label="Footer">
						<a href="/media">Media</a>
						<a href="/privacy">Privacy</a>
						<a href="/terms">Terms</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
