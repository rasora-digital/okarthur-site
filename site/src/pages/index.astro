---
import Base from '../layouts/Base.astro';
import { PERSON_ID } from '../lib/schema';
import { getCollection } from 'astro:content';

const website = {
	'@type': 'WebSite',
	name: 'OkArthur',
	url: 'https://okarthur.com',
	author: { '@id': PERSON_ID },
	publisher: { '@id': PERSON_ID },
};

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const [latest] = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const gateways = [
	{
		href: '/work',
		label: 'What you can commission',
		target: 'Work',
		teaser:
			'An independent review before a decision is confirmed, continuing advisory, or a non-executive or board appointment.',
	},
	{
		href: '/notes',
		label: 'How I think',
		target: 'Notes',
		teaser:
			'Short notes on how large owners decide and what one development commits another to.',
	},
	{
		href: '/about',
		label: 'Who I am',
		target: 'About',
		teaser:
			'Sixteen years on live capital programmes in the Gulf and the UK, including the first integrated infrastructure plan for the Riyadh region.',
	},
];
---

<Base
	title="Steven Yule, digital, data and AI for infrastructure owners"
	titleIsComplete
	description="Chartered civil engineer in Dubai. Digital, data and AI for owners delivering more than one development at once. Review, advisory and board work."
	schema={[website]}
	sheet="Home"
>
	<div class="hero">
		<picture class="hero-photo">
			<source
				type="image/webp"
				srcset="/steven-yule-portrait-360.webp 360w, /steven-yule-portrait-720.webp 720w"
				sizes="(min-width: 48em) 11rem, 5.5rem"
			/>
			<img
				class="portrait"
				src="/steven-yule-portrait-360.jpg"
				srcset="/steven-yule-portrait-360.jpg 360w, /steven-yule-portrait-720.jpg 720w"
				sizes="(min-width: 48em) 11rem, 5.5rem"
				alt="Steven Yule"
				width="360"
				height="450"
				fetchpriority="high"
			/>
		</picture>
		<div class="hero-text">
			<h1 class="hero-title">
				Digital, data and AI for owners delivering more than one development at
				once.
			</h1>
			<p class="standfirst">
				I am Steven Yule, a chartered civil engineer based in Dubai. I lead
				digital, data and AI work for infrastructure across the GCC and the UK.
				Owners usually bring me in when one decision reaches across several of
				their developments, and the evidence for it sits with teams that each
				report on their own part.
			</p>
			<p class="standfirst pen-mark">
				A road closure agreed for one site can hold up a utility connection that
				another site is waiting for. Neither programme will show the problem
				until the date has passed. I read the programmes and contracts each
				development already holds against each other, and set out what the
				decision commits elsewhere while there is still time to change it.
			</p>
			<p class="meta hero-credentials">
				CEng FICE FCIHT MIAM. ICE UAE Country Representative and ICE Policy
				Fellow.
			</p>
		</div>
	</div>

	<nav class="gateways" aria-label="Main sections">
		{
			gateways.map((gateway) => (
				<a class="gateway" href={gateway.href}>
					<span class="gateway-row">
						<span class="gateway-label">{gateway.label}</span>
						<span class="gateway-target">{gateway.target}</span>
					</span>
					<span class="gateway-teaser">{gateway.teaser}</span>
				</a>
			))
		}
	</nav>

	{
		latest && (
			<p class="meta hero-latest">
				Latest note. <a href={`/notes/${latest.id}`}>{latest.data.title}</a>,{' '}
				{dateFormatter.format(latest.data.pubDate)}.
			</p>
		)
	}
</Base>
