---
import Base from '../layouts/Base.astro';
import { PERSON_ID } from '../lib/schema';
import { getCollection } from 'astro:content';

const website = {
	'@type': 'WebSite',
	name: 'OkArthur',
	url: 'https://okarthur.com',
	author: { '@id': PERSON_ID },
	publisher: { '@id': PERSON_ID },
};

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const [latest] = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const gateways = [
	{
		href: '/work',
		label: 'What you can commission',
		target: 'Work',
		teaser:
			'A review of a decision before it is confirmed, continuing advisory, and non-executive and board roles.',
	},
	{
		href: '/notes',
		label: 'How I think',
		target: 'Notes',
		teaser:
			'Short notes on how large owners decide and what one development commits another to.',
	},
	{
		href: '/about',
		label: 'Who I am',
		target: 'About',
		teaser:
			'The background behind the work, chartered engineer, ICE fellow, director-level digital and data leader.',
	},
];
---

<Base
	title="Steven Yule, digital, data and AI for infrastructure owners"
	titleIsComplete
	description="Chartered civil engineer in Dubai. Digital, data and AI for owners delivering more than one development at once. Review, advisory and board work."
	schema={[website]}
>
	<h1 class="hero-title">
		Digital, data and AI for owners delivering more than one development at
		once.
	</h1>
	<p class="standfirst">
		I am Steven Yule, a chartered civil engineer working at director level in
		digital, data and AI for infrastructure, across the GCC and the UK. Owners
		bring me in when a decision commits more than one development or
		programme, and the evidence for it sits in several places and several
		hands. What they get is one view across the whole, traced back to the
		material rather than to the reports, and a judgement with no stake in the
		answer.
	</p>
	<p class="meta hero-credentials">
		CEng FICE FCIHT MIAM. ICE UAE Country Representative and ICE Policy
		Fellow.
	</p>

	<nav class="gateways reveal" aria-label="Main sections">
		{
			gateways.map((gateway) => (
				<a class="gateway" href={gateway.href}>
					<span class="gateway-row">
						<span class="gateway-label">{gateway.label}</span>
						<span class="gateway-target">{gateway.target}</span>
					</span>
					<span class="gateway-teaser">{gateway.teaser}</span>
				</a>
			))
		}
	</nav>

	{
		latest && (
			<p class="meta hero-latest">
				Latest note. <a href={`/notes/${latest.id}`}>{latest.data.title}</a>,{' '}
				{dateFormatter.format(latest.data.pubDate)}.
			</p>
		)
	}
</Base>
