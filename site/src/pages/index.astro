---
import Base from '../layouts/Base.astro';
import { PERSON_ID } from '../lib/schema';
import { getCollection } from 'astro:content';

const website = {
	'@type': 'WebSite',
	name: 'OkArthur',
	url: 'https://okarthur.com',
	author: { '@id': PERSON_ID },
	publisher: { '@id': PERSON_ID },
};

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const [latest] = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const gateways = [
	{
		href: '/work',
		label: 'What you can commission',
		target: 'Work',
		teaser:
			'An independent review before a decision is confirmed, continuing advisory, or a non-executive or board appointment.',
	},
	{
		href: '/notes',
		label: 'How I think',
		target: 'Notes',
		teaser:
			'Short notes on how large owners decide and what one development commits another to.',
	},
	{
		href: '/about',
		label: 'Who I am',
		target: 'About',
		teaser:
			'17 years on capital programmes in the Gulf and the UK, including the first integrated infrastructure plan for the Riyadh region.',
	},
];
---

<Base
	title="Steven Yule, digital, data and AI for infrastructure owners"
	titleIsComplete
	description="Chartered civil engineer in Dubai. Digital, data and AI for owners delivering more than one development at once. Review, advisory and board work."
	schema={[website]}
	sheet="Home"
>
	<h1 class="hero-title">
		Digital, data and AI for owners delivering more than one development at
		once.
	</h1>
	<p class="standfirst">
		I am Steven Yule, a chartered civil engineer based in Dubai. I lead
		digital, data and AI work for infrastructure in the GCC and the UK.
	</p>
	<p class="standfirst">
		Owners with several developments are measured on where the portfolio
		lands. That is usually a range for the portfolio as a whole, such as a
		return or a number of homes. It is seldom a fixed target for each
		development.
	</p>
	<p class="standfirst pen-mark">
		Plans change while the work is under way. When one development slips by
		a year, the question is what can move elsewhere to keep the portfolio in
		range.
		Another phase might be brought forward. A shared road or utility
		connection might be built in a different order. I set out those options
		and what each one commits, while there is still time to use them.
	</p>
	<p class="meta hero-credentials">
		CEng FICE FCIHT MIAM. ICE UAE Country Representative and ICE Policy
		Fellow.
	</p>

	<nav class="gateways" aria-label="Main sections">
		{
			gateways.map((gateway) => (
				<a class="gateway" href={gateway.href}>
					<span class="gateway-row">
						<span class="gateway-label">{gateway.label}</span>
						<span class="gateway-target">{gateway.target}</span>
					</span>
					<span class="gateway-teaser">{gateway.teaser}</span>
				</a>
			))
		}
	</nav>

	{
		latest && (
			<p class="meta hero-latest">
				Latest note. <a href={`/notes/${latest.id}`}>{latest.data.title}</a>,{' '}
				{dateFormatter.format(latest.data.pubDate)}.
			</p>
		)
	}
</Base>
