				<rect class="fig-bar" x="48" y="100" width="170" height="6" />

				<rect class="fig-box" x="48" y="122" width="384" height="148" />
				<text class="fig-label" x="64" y="146">RELIANCE STATEMENT</text>

				<text class="fig-text" x="64" y="178">Decision reviewed</text>
				<rect class="fig-bar" x="214" y="170" width="190" height="6" />
				<text class="fig-text" x="64" y="210">Material examined</text>
				<rect class="fig-bar" x="214" y="202" width="160" height="6" />
				<text class="fig-text" x="64" y="242">Date issued</text>
				<rect class="fig-bar" x="214" y="234" width="90" height="6" />

				<path
					class="fig-pen"
					d="M58 172 C58 160 120 158 186 160 C204 161 206 179 190 183 C150 189 76 188 60 181 C55 179 56 175 60 172"
				/>
				<path
					class="fig-pen"
					d="M57 204 C58 192 124 190 188 192 C205 193 206 211 190 215 C148 221 74 220 59 213 C54 211 55 207 60 204"
				/>
				<path
					class="fig-pen"
					d="M57 236 C58 225 110 223 150 224 C166 225 167 243 151 247 C120 252 72 251 59 245 C54 243 55 239 60 236"
				/>
