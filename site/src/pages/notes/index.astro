---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { elsewhere, elsewhereDate } from '../../lib/elsewhere';
import { FEED_PATH } from '../../lib/feed';

/** The Notes index shows the most recent external pieces; the rest are on
    the Published elsewhere page. */
const RECENT_ELSEWHERE = 5;
const recentElsewhere = elsewhere.slice(0, RECENT_ELSEWHERE);

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const notes = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Base
	title="Notes"
	description="Working notes on digital, data and AI in infrastructure, on how large owners decide and what one development commits another to."
>
	<div class="page-head">
		<h1 class="page-title">Notes</h1>
		<p class="lede">
			These are short working notes on digital, data and AI in infrastructure,
			mostly about how large owners decide and what one development commits
			another to.
		</p>
	</div>

	{
		notes.length === 0 ? (
			<p class="contents-empty">No notes published yet.</p>
		) : (
			<ul class="contents">
				{notes.map((note) => (
					<li>
						<div class="entry">
							<div class="entry-meta">
								<time class="meta" datetime={isoDate(note.data.pubDate)}>
									{dateFormatter.format(note.data.pubDate)}
								</time>
							</div>
							<div class="entry-body">
								<h2 class="contents-title">
									<a href={`/notes/${note.id}`}>{note.data.title}</a>
								</h2>
								<p class="contents-summary">{note.data.description}</p>
							</div>
						</div>
					</li>
				))}
			</ul>
		)
	}

	<p class="notes-feed meta">
		New notes are also published as an <a href={FEED_PATH}>RSS feed</a>.
	</p>

	<div class="elsewhere">
		<h2 class="elsewhere-title">Published elsewhere</h2>
		<p>
			These are the most recent pieces of writing and talks for other
			publications and institutions. <a href="/elsewhere/">The full list</a> goes
			back to 2022.
		</p>
		<ul class="elsewhere-list">
			{
				recentElsewhere.map((item) => (
					<li>
						<a href={item.url} target="_blank" rel="noopener noreferrer">
							{item.title}
						</a>
						<span class="elsewhere-source">
							{[item.source, elsewhereDate(item.date)].filter(Boolean).join(', ')}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</Base>
