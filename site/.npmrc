# No package may run an install script on npm install or npm ci, here, in CI
# or in the deploy. Worms such as Shai-Hulud spread through preinstall
# scripts. Nothing this site uses needs one: the only package with an install
# script is fsevents, which is macOS-only and optional. npm run still runs the
# scripts in package.json. If a future dependency genuinely needs its install
# script, the build will fail and say so, and this is the line to revisit.
ignore-scripts=true
